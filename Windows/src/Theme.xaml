<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AudioMixer;assembly=AudioMixer">

    <!-- Cutroom palette (src/studio/styles.css :root). -->
    <SolidColorBrush x:Key="InkBrush" Color="#0A0A0B"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#111113"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#161618"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#101211"/>
    <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="LineHoverBrush" Color="#47FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="CreamBrush" Color="#EDEDEF"/>
    <SolidColorBrush x:Key="BrandBrush" Color="#4F3DFF"/>
    <SolidColorBrush x:Key="BrandSoftBrush" Color="#294F3DFF"/>
    <SolidColorBrush x:Key="BrandTextBrush" Color="#9A8FFF"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#249A8FFF"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#1DD9F9"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF8B79"/>

    <FontFamily x:Key="UiFont">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="PopupShadow" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black"/>

    <!-- Thin scrollbars with no track, as in Cutroom. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumb" Margin="2,0" CornerRadius="2" Background="#1FFFFFFF"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="#3DFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost button: transparent until hovered, one hairline border. -->
    <Style x:Key="GhostButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="border" Background="Transparent" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource LineHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrandTextBrush}"/>
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrandSoftBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one solid button: brand indigo. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{StaticResource BrandBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#6455FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimise / maximise / close in the header. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Device picker -->
    <DataTemplate x:Key="DeviceOptionTemplate">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                       VerticalAlignment="Center" Margin="0,0,9,0" Opacity="0.75"/>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
    </DataTemplate>

    <Style x:Key="PickerItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="10,8" MinHeight="34">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrandSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource MenuHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Picker" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Width" Value="250"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SelectedValuePath" Value="Id"/>
        <Setter Property="ItemTemplate" Value="{StaticResource DeviceOptionTemplate}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border" Background="{StaticResource Panel2Brush}"
                                            BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource LineHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrandTextBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <DockPanel IsHitTestVisible="False" Margin="11,0,11,0">
                            <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"/>
                        </DockPanel>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Placement="Bottom" HorizontalOffset="-12" Focusable="False" PopupAnimation="Fade">
                            <Border Margin="12,6,12,20" Padding="6" MinWidth="{TemplateBinding ActualWidth}" MaxWidth="380" MaxHeight="320"
                                    Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineStrongBrush}"
                                    BorderThickness="1" CornerRadius="10" Effect="{StaticResource PopupShadow}"
                                    TextElement.FontFamily="{StaticResource UiFont}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="toggle" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Volume slider: hairline track, brand fill, round thumb. -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" CornerRadius="2" Margin="0,0,-4,0" Background="{StaticResource BrandTextBrush}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VolumeSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="SmallChange" Value="1"/>
        <Setter Property="LargeChange" Value="10"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="18" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="#1FFFFFFF" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRest}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="knob" Fill="{StaticResource CreamBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="knob" Property="Fill" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus (tray and gear) -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="12,8,12,20" Padding="6" MinWidth="230" MaxHeight="560"
                            Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineStrongBrush}"
                            BorderThickness="1" CornerRadius="10" Effect="{StaticResource PopupShadow}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="6,0,10,0" MinHeight="32">
                            <DockPanel>
                                <TextBlock x:Name="check" DockPanel.Dock="Left" Width="22" Text="&#xE73E;" TextAlignment="Center"
                                           FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,4,0"
                                           Foreground="{StaticResource BrandTextBrush}" VerticalAlignment="Center" Visibility="Hidden"/>
                                <TextBlock x:Name="arrow" DockPanel.Dock="Right" Text="&#xE76C;"
                                           FontFamily="{StaticResource IconFont}" FontSize="9" Margin="18,0,0,0"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-10" VerticalOffset="-15"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Margin="12,8,12,20" Padding="6" MinWidth="220" MaxHeight="480"
                                    Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineStrongBrush}"
                                    BorderThickness="1" CornerRadius="10" Effect="{StaticResource PopupShadow}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource MenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,5" Background="{StaticResource LineBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#19191F" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="9,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One app -->
    <DataTemplate x:Key="AppCardTemplate">
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource Picker}" VerticalAlignment="Center" Margin="12,0,0,0"
                              ItemsSource="{Binding Options}" SelectedValue="{Binding DeviceId, Mode=TwoWay}"
                              Visibility="{Binding PickerVisibility}" ToolTip="Output device for this app"/>
                    <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border CornerRadius="9" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Visibility="{Binding FallbackIconVisibility}">
                            <TextBlock Text="{Binding FallbackGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding RoutedVisibility}">
                                <TextBlock Text="·" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="6,0"/>
                                <TextBlock Text="Routed" FontSize="11" Foreground="{StaticResource BrandTextBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding MissingVisibility}">
                                <TextBlock Text="·" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="6,0"/>
                                <TextBlock Text="Device not connected" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="50,12,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeText}" Width="38" TextAlignment="Right" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                    <StackPanel>
                        <Slider Style="{StaticResource VolumeSlider}" Value="{Binding Volume, Mode=TwoWay}" ToolTip="Volume for this app"/>
                        <local:LevelMeter Level="{Binding Level}" Height="4" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}" Margin="50,10,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
